node_modules/
dist/
*.tsbuildinfo
.DS_Store
.eslintcache
coverage/

# Go build artifact (go build in apps/bff drops the binary in-place)
apps/bff/bff
.vitest-report.json

# Per-worker reach shards, written by test-setup.ts and read by check-audit-reach.mjs. Cleared at
# the start of every vitest run, because a stale shard would let a run that measured nothing be
# answered from a run that did.
apps/web/.reach/

# Release artifacts from scripts/build-release.sh. Ignored not just for tidiness: an untracked
# build output would make `git status --porcelain` dirty, and the script's dirty-tree check would
# then stamp every subsequent build "-dirty" because of its own previous output.
bff-*-*
